#!/usr/bin/env node
import fs from "node:fs";
import path from "node:path";

const args = process.argv.slice(2);
if (args[0] === "--version") {
  console.log("codex-cli 0.169.1");
  process.exit(0);
}
if (args[0] === "login" && args[1] === "status") {
  console.log("Logged in using ChatGPT");
  process.exit(0);
}

const stdinText = fs.readFileSync(0, "utf8");
const recordFile = process.env.TRIRELAY_TEST_RECORD_FILE;
if (recordFile) {
  fs.appendFileSync(
    recordFile,
    `${JSON.stringify({
      bin: "codex",
      argv: args,
      cwd: process.cwd(),
      stdinLen: stdinText.length,
      claudecode: process.env.CLAUDECODE ?? null,
      claudeSession: process.env.CLAUDE_CODE_SESSION_ID ?? null,
      pluginData: process.env.PLUGIN_DATA ?? null,
      trirelayDepth: process.env.TRIRELAY_DEPTH ?? null
    })}\n`
  );
}

if (process.env.TRIRELAY_TEST_CODEX_PARTIAL_FAIL === "1") {
  console.log(JSON.stringify({ type: "thread.started", thread_id: "codex-thr-partial" }));
  console.log(JSON.stringify({ type: "turn.started" }));
  fs.writeFileSync(path.join(process.cwd(), "partial.txt"), "half-written\n");
  console.log(JSON.stringify({ type: "turn.failed", error: { message: "timed out mid-turn" } }));
  process.exit(1);
}

const isReview = stdinText.includes("Perform a strict, adversarial code review");
const hasSchema = args.includes("--output-schema");
let outText = "FAKE_CODEX_OK";
if (isReview) {
  outText = JSON.stringify({ verdict: "approve", summary: "Clean", findings: [], next_steps: [] });
} else if (hasSchema) {
  outText = JSON.stringify({ status: "done", summary: "ok", findings: [], files_touched: [], checks_run: [], next_actions: [] });
}

if (process.env.TRIRELAY_TEST_CODEX_COMMIT === "1") {
  fs.writeFileSync(path.join(process.cwd(), "committed file.txt"), "hello committed\n");
}

if (process.env.TRIRELAY_TEST_IGNORED_ONLY === "1") {
  fs.mkdirSync(path.join(process.cwd(), "dist-ignored"), { recursive: true });
  fs.writeFileSync(path.join(process.cwd(), "dist-ignored", "out.bin"), "ignored-artifact\n");
  outText = "CREATED_IGNORED_ONLY";
}

if (process.env.TRIRELAY_TEST_CREATE_FEATURE === "1") {
  const featPath = path.join(process.cwd(), "src", "feature.txt");
  const isResume = args.includes("resume") || args.includes("fork");
  if (!isResume) {
    fs.mkdirSync(path.dirname(featPath), { recursive: true });
    fs.writeFileSync(featPath, "turn1=ok\n");
    outText = `TURN1_CREATED cwd=${process.cwd()}`;
  } else {
    const hasFeature = fs.existsSync(featPath);
    if (hasFeature) {
      fs.appendFileSync(featPath, "turn2=ok\n");
    }
    outText = `TURN2_RESUME hasFeature=${hasFeature} cwd=${process.cwd()}`;
  }
}

console.log(JSON.stringify({ type: "thread.started", thread_id: "codex-thr-test-1" }));
console.log(JSON.stringify({ type: "turn.started" }));
console.log(JSON.stringify({ type: "item.completed", item: { id: "item_1", type: "agent_message", text: outText } }));
console.log(JSON.stringify({ type: "turn.completed", usage: { input_tokens: 10, output_tokens: 5 } }));
