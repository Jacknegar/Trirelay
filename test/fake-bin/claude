#!/usr/bin/env node
import fs from "node:fs";

const args = process.argv.slice(2);
if (args[0] === "--version") {
  console.log("2.1.325 (Claude Code)");
  process.exit(0);
}
if (args[0] === "auth" && args[1] === "status") {
  console.log(JSON.stringify({ loggedIn: true, subscriptionType: "pro" }));
  process.exit(0);
}

const stdinText = fs.readFileSync(0, "utf8");
const recordFile = process.env.TRIRELAY_TEST_RECORD_FILE;
if (recordFile) {
  fs.appendFileSync(
    recordFile,
    `${JSON.stringify({
      bin: "claude",
      argv: args,
      cwd: process.cwd(),
      stdinLen: stdinText.length,
      claudecode: process.env.CLAUDECODE ?? null,
      claudeSession: process.env.CLAUDE_CODE_SESSION_ID ?? null,
      pluginData: process.env.PLUGIN_DATA ?? null,
      trirelayDepth: process.env.TRIRELAY_DEPTH ?? null
    })}\n`
  );
}

if (process.env.TRIRELAY_TEST_DELAY_MS) {
  const delayMs = Math.max(0, Number(process.env.TRIRELAY_TEST_DELAY_MS) || 0);
  if (delayMs > 0) {
    await new Promise((r) => setTimeout(r, delayMs));
  }
}

if (process.env.TRIRELAY_TEST_CLAUDE_FAIL === "1") {
  console.error("simulated claude failure");
  process.exit(1);
}

const hasSchema = args.includes("--json-schema");
const isReview = stdinText.includes("Perform a strict, adversarial code review");
const isCopy = stdinText.includes("Review the draft copy");
let structured;
if (isCopy) {
  structured = {
    summary: "1 wording suggestion",
    rows: [{ location: "README:1", current: "Done now", problem: "Wordy", suggestion: "Ready" }]
  };
} else if (isReview) {
  const manyCount = Number.parseInt(process.env.TRIRELAY_TEST_MANY_FINDINGS || "0", 10);
  if (manyCount > 0) {
    structured = {
      verdict: "needs-attention",
      summary: `${manyCount} blocking defects detected`,
      findings: Array.from({ length: manyCount }, (_, i) => ({
        severity: "blocking",
        title: `Critical defect #${i + 1}: unchecked boundary condition in handler`,
        body: `Detailed explanation for finding #${i + 1}: `.repeat(25),
        file: `src/module_${i + 1}.js`,
        line_start: 10 + i,
        line_end: 25 + i,
        trigger_path: `Caller invokes endpoint_${i + 1} with negative quantity triggering integer underflow #${i + 1}`,
        recommendation: `Validate and clamp input in module_${i + 1}.js before state mutation.`
      })),
      next_steps: ["Inspect paginated findings and patch all blocking items"]
    };
  } else {
    structured =
      process.env.TRIRELAY_TEST_REVIEW_BLOCKING === "1"
        ? {
            verdict: "needs-attention",
            summary: "Blocking bug found",
            findings: [
              {
                severity: "blocking",
                title: "Auth bypass",
                body: "Missing token check",
                file: "src/auth.js",
                line_start: 10,
                line_end: 12,
                trigger_path: "Unauthenticated request to /admin bypasses check",
                recommendation: "Enforce token check"
              }
            ],
            next_steps: ["Fix auth check"]
          }
        : { verdict: "approve", summary: "Clean", findings: [], next_steps: [] };
  }
} else if (hasSchema) {
  structured = { status: "done", summary: "ok", findings: [], files_touched: [], checks_run: [], next_actions: [] };
}

console.log(JSON.stringify({ type: "system", subtype: "init", session_id: "claude-sess-test-1", model: "claude-opus-5-5" }));
console.log(
  JSON.stringify({
    type: "assistant",
    message: { content: [{ type: "text", text: structured ? JSON.stringify(structured) : "FAKE_CLAUDE_OK" }] }
  })
);
console.log(
  JSON.stringify({
    type: "result",
    uuid: "res-1",
    session_id: "claude-sess-test-1",
    is_error: false,
    result: structured ? JSON.stringify(structured) : "FAKE_CLAUDE_OK",
    ...(structured ? { structured_output: structured } : {})
  })
);
